<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>data_tamer_v2</name>
  <version>2.1.0</version>
  <description>
  Logs C++ variables of real-time programs as periodic snapshots (allocation-free,
  lock-free) to MCAP files, a RAM flight recorder or ROS 2 topics. Version 2 of
  data_tamer_cpp; installs side by side with it.
  </description>

  <maintainer email="davide.faconti@gmail.com">Davide Faconti</maintainer>
  <maintainer email="henrygerardmoore@gmail.com">Henry Moore</maintainer>
  <maintainer email="nathanbrooks@picknik.ai">Nathan Brooks</maintainer>

  <license>MIT</license>

  <url type="website">https://github.com/facontidavide/data_tamer</url>
  <url type="repository">https://github.com/facontidavide/data_tamer.git</url>
  <url type="bugtracker">https://github.com/facontidavide/data_tamer/issues</url>

  <author>Davide Faconti</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>mcap_vendor</depend>
  <depend>data_tamer_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gtest_vendor</test_depend>

  <export>
      <build_type>ament_cmake</build_type>
  </export>

</package>
